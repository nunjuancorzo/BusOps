@page "/viajes/{tipo?}"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using BusOps.Data
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<BusOpsDbContext> DbFactory
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>@(Tipo == "discrecionales" ? "Viajes Discrecionales" : "Viajes Fijos")</PageTitle>

<h3 class="mb-4">
    @if (Tipo == "discrecionales")
    {
        <i class="bi bi-airplane-fill" style="color: #9C27B0;"></i> <text>Viajes Discrecionales</text>
    }
    else
    {
        <i class="bi bi-calendar-week-fill" style="color: #003366;"></i> <text>Viajes Fijos</text>
    }
</h3>

@if (Tipo == "fijos" || string.IsNullOrEmpty(Tipo))
{
    <div class="mb-3">
        <button class="btn" style="background-color: #003366; color: white;" data-bs-toggle="modal" data-bs-target="#viajeModal" @onclick="MostrarFormularioNuevo">
            <span class="bi bi-plus-circle"></span> Nuevo Viaje Fijo
        </button>
    </div>
}
else
{
    <div class="mb-3">
        <button class="btn" style="background-color: #9C27B0; color: white;" data-bs-toggle="modal" data-bs-target="#viajeDiscrecionalModal" @onclick="MostrarFormularioNuevoDiscrecional">
            <span class="bi bi-plus-circle"></span> Nuevo Viaje Discrecional
        </button>
    </div>
}

<!-- Modal Viaje Fijo -->
<div class="modal fade" id="viajeModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #003366;">
                <h5 class="modal-title">@(viajeSeleccionado.Id > 0 ? "Editar Viaje Fijo" : "Nuevo Viaje Fijo")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-basico-fijo">Básico</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-horarios-fijo">Horarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-asignaciones-fijo">Asignaciones</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-importes-fijo">Importes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-adicional-fijo">Adicional</a>
                    </li>
                </ul>
                
                <div class="tab-content p-3">
                    <!-- Tab Básico -->
                    <div class="tab-pane fade show active" id="tab-basico-fijo">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ruta *</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="viajeSeleccionado!.RutaId" @bind:after="OnRutaSeleccionada">
                                        <option value="0">-- Seleccione una ruta --</option>
                                        @foreach (var ruta in rutas.Where(r => r.Activa))
                                        {
                                            <option value="@ruta.Id">@ruta.Nombre</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-success" type="button" data-bs-toggle="modal" data-bs-target="#rutaModal" @onclick="MostrarFormularioNuevaRuta">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Código</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.Codigo" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Referencia</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.Referencia" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cliente</label>
                                <select class="form-select" @bind="viajeSeleccionado!.ClienteId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var cliente in clientes)
                                    {
                                        <option value="@cliente.Id">@(cliente.NombreEmpresa ?? $"{cliente.Nombre} {cliente.Apellidos}")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Plazas</label>
                                <input type="number" class="form-control" @bind="viajeSeleccionado!.Plazas" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Estado *</label>
                                <select class="form-select" @bind="viajeSeleccionado!.Estado">
                                    @foreach (var estado in Enum.GetValues<EstadoViaje>())
                                    {
                                        <option value="@estado">@estado.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" rows="2" @bind="viajeSeleccionado!.Descripcion"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lugar de Salida</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.LugarSalida" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lugar de Llegada</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.LugarLlegada" />
                            </div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="viajeSeleccionado!.Anulado" />
                            <label class="form-check-label">Anulado</label>
                        </div>
                    </div>
                    
                    <!-- Tab Horarios -->
                    <div class="tab-pane fade" id="tab-horarios-fijo">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha y Hora de Salida *</label>
                                <input type="datetime-local" class="form-control" @bind="fechaHoraSalida" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha y Hora Llegada Estimada *</label>
                                <input type="datetime-local" class="form-control" @bind="fechaHoraLlegadaEstimada" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Presentación</label>
                                <input type="time" class="form-control" @bind="horaPresentacionFijo" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Salida</label>
                                <input type="time" class="form-control" @bind="horaSalidaFijo" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Llegada</label>
                                <input type="time" class="form-control" @bind="horaLlegadaFijo" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Inicio</label>
                                <input type="number" class="form-control" @bind="viajeSeleccionado!.KmsInicio" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Fin</label>
                                <input type="number" class="form-control" @bind="viajeSeleccionado!.KmsFin" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Totales</label>
                                <input type="number" class="form-control" @bind="viajeSeleccionado!.KmsTotales" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tab Asignaciones -->
                    <div class="tab-pane fade" id="tab-asignaciones-fijo">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Autobús *</label>
                                <select class="form-select" @bind="viajeSeleccionado!.AutobusId" @bind:after="OnAutobusSeleccionado">
                                    <option value="0">-- Seleccione un autobús --</option>
                                    @foreach (var autobus in autobuses.Where(a => a.Estado == EstadoAutobus.Disponible))
                                    {
                                        <option value="@autobus.Id">@autobus.Matricula - @autobus.Marca @autobus.Modelo</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Asientos Disponibles *</label>
                                <input type="number" class="form-control" @bind="viajeSeleccionado!.AsientosDisponibles" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Conductor Principal *</label>
                                <select class="form-select" @bind="viajeSeleccionado!.ConductorId">
                                    <option value="0">-- Seleccione un conductor --</option>
                                    @foreach (var conductor in conductores.Where(c => c.Estado == EstadoConductor.Activo))
                                    {
                                        <option value="@conductor.Id">@conductor.Nombre @conductor.Apellidos</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Conductor 2</label>
                                <select class="form-select" @bind="viajeSeleccionado!.Conductor2Id">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var conductor in conductores.Where(c => c.Estado == EstadoConductor.Activo))
                                    {
                                        <option value="@conductor.Id">@conductor.Nombre @conductor.Apellidos</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Responsable</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.Responsable" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre de Grupo</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.NombreGrupo" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tab Importes -->
                    <div class="tab-pane fade" id="tab-importes-fijo">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Precio del Viaje (€) *</label>
                                <input type="number" step="0.01" class="form-control" @bind="viajeSeleccionado!.PrecioViaje" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Importe</label>
                                <input type="number" step="0.01" class="form-control" @bind="viajeSeleccionado!.Importe" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Total Importe</label>
                                <input type="number" step="0.01" class="form-control" @bind="viajeSeleccionado!.TotalImporte" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Total Proveedor</label>
                                <input type="number" step="0.01" class="form-control" @bind="viajeSeleccionado!.TotalProveedor" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Número Factura</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.NumeroFactura" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Comisionista</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.Comisionista" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Importe Comisionista</label>
                                <input type="number" step="0.01" class="form-control" @bind="viajeSeleccionado!.ImporteComisionista" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tab Adicional -->
                    <div class="tab-pane fade" id="tab-adicional-fijo">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Expediente</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.Expediente" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tipo Servicio</label>
                                <input type="text" class="form-control" @bind="viajeSeleccionado!.ServicioTipo" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ampliación</label>
                            <textarea class="form-control" rows="2" @bind="viajeSeleccionado!.Ampliacion"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Itinerario</label>
                            <textarea class="form-control" rows="2" @bind="viajeSeleccionado!.Itinerario"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notas Internas</label>
                            <textarea class="form-control" rows="2" @bind="viajeSeleccionado!.NotasInternas"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notas</label>
                            <textarea class="form-control" rows="2" @bind="viajeSeleccionado!.Notas"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="d-flex justify-content-between w-100">
                    <div>
                        @if (viajeSeleccionado.Id > 0)
                        {
                            <button type="button" class="btn btn-success" @onclick="() => GenerarFacturaDesdeViajeFijo(viajeSeleccionado.Id)">
                                <i class="bi bi-receipt"></i> Generar Factura
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn" style="background-color: #003366; color: white;" @onclick="GuardarViaje">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Ruta -->
<div class="modal fade" id="rutaModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #AB47BC;">
                <h5 class="modal-title">Nueva Ruta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la Ruta *</label>
                    <input type="text" class="form-control" @bind="nuevaRuta.Nombre" placeholder="Ej: Madrid - Barcelona Express" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Origen *</label>
                        <input type="text" class="form-control" @bind="nuevaRuta.Origen" placeholder="Ciudad origen" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Destino *</label>
                        <input type="text" class="form-control" @bind="nuevaRuta.Destino" placeholder="Ciudad destino" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Distancia (km) *</label>
                        <input type="number" step="0.1" class="form-control" @bind="nuevaRuta.DistanciaKm" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Duración (horas) *</label>
                        <input type="number" step="0.5" class="form-control" @bind="duracionHoras" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Precio Base (€) *</label>
                    <input type="number" step="0.01" class="form-control" @bind="nuevaRuta.PrecioBase" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" @onclick="GuardarNuevaRuta">
                    <i class="bi bi-plus-circle"></i> Crear Ruta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Viaje Discrecional -->
<div class="modal fade" id="viajeDiscrecionalModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #9C27B0;">
                <h5 class="modal-title">@(viajeDiscrecionalSeleccionado.Id > 0 ? "Editar Viaje Discrecional" : "Nuevo Viaje Discrecional")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-basico">Básico</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-horarios">Horarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-asignaciones">Asignaciones</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-importes">Importes</a>
                    </li>
                </ul>
                
                <div class="tab-content p-3">
                    <!-- Tab Básico -->
                    <div class="tab-pane fade show active" id="tab-basico">
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Código *</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.Codigo" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Referencia</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.Referencia" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Expediente</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.Expediente" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Plazas</label>
                                <input type="number" class="form-control" @bind="viajeDiscrecionalSeleccionado!.Plazas" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cliente</label>
                                <select class="form-select" @bind="viajeDiscrecionalSeleccionado!.ClienteId">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var cliente in clientes)
                                    {
                                        <option value="@cliente.Id">@(cliente.NombreEmpresa ?? $"{cliente.Nombre} {cliente.Apellidos}")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Estado</label>
                                <select class="form-select" @bind="viajeDiscrecionalSeleccionado!.Estado">
                                    @foreach (var estado in Enum.GetValues<EstadoViaje>())
                                    {
                                        <option value="@estado">@estado.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" rows="2" @bind="viajeDiscrecionalSeleccionado!.Descripcion"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ampliación</label>
                            <textarea class="form-control" rows="2" @bind="viajeDiscrecionalSeleccionado!.Ampliacion"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lugar de Salida</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.LugarSalida" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lugar de Llegada</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.LugarLlegada" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Tab Horarios -->
                    <div class="tab-pane fade" id="tab-horarios">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fecha Salida</label>
                                <input type="date" class="form-control" @bind="viajeDiscrecionalSeleccionado!.FechaSalida" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Presentación</label>
                                <input type="time" class="form-control" @bind="horaPresentacionDisc" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Salida</label>
                                <input type="time" class="form-control" @bind="horaSalidaDisc" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fecha Llegada</label>
                                <input type="date" class="form-control" @bind="viajeDiscrecionalSeleccionado!.FechaLlegada" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Llegada</label>
                                <input type="time" class="form-control" @bind="horaLlegadaDisc" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo Servicio</label>
                                <input type="text" class="form-control" @bind="viajeDiscrecionalSeleccionado!.ServicioTipo" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Inicio</label>
                                <input type="number" class="form-control" @bind="viajeDiscrecionalSeleccionado!.KmsInicio" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Fin</label>
                                <input type="number" class="form-control" @bind="viajeDiscrecionalSeleccionado!.KmsFin" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kms Totales</label>
                                <input type="number" class="form-control" @bind="viajeDiscrecionalSeleccionado!.KmsTotales" />
                            </div>
                        </div>
                        <hr class="my-3" />
                        <h6 class="text-muted mb-3">Horarios de Cierre</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Hora Presentación Cierre</label>
                                <input type="time" class="form-control" @bind="horaPresentacionCierreDisc" />
                            </div>
                            <div class="col-md-4 mb-3">
