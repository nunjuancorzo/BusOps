                viajeExistente.ImporteComisionista = viajeDiscrecionalSeleccionado.ImporteComisionista;
                
                // Estado
                viajeExistente.Anulado = viajeDiscrecionalSeleccionado.Anulado;
                viajeExistente.Estado = viajeDiscrecionalSeleccionado.Estado;
            }
        }
        
        await context.SaveChangesAsync();
        
        await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('viajeDiscrecionalModal')).hide()");
        
        await CargarViajes();
        viajeDiscrecionalSeleccionado = new();
    }
    
    private async Task EliminarViajeDiscrecional(int id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        
        var viaje = await context.ViajesDiscrecionales.FindAsync(id);
        if (viaje != null)
        {
            context.ViajesDiscrecionales.Remove(viaje);
            await context.SaveChangesAsync();
            await CargarViajes();
        }
    }

    private async Task GenerarFacturaDesdeViajeDiscrecional(int viajeId)
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.IsSuperAdmin = IsSuperAdmin;
            context.CurrentEmpresaId = CurrentEmpresaId;
            
            // Obtener el viaje con sus datos relacionados
            var viaje = await context.ViajesDiscrecionales
                .Include(v => v.Cliente)
                .FirstOrDefaultAsync(v => v.Id == viajeId);
            
            if (viaje == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se encontró el viaje");
                return;
            }
            
            if (viaje.ClienteId == null || viaje.ClienteId == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "El viaje debe tener un cliente asignado para generar una factura");
                return;
            }
            
            // Obtener configuración para generar número de factura
            var config = await context.ConfiguracionEmpresa.FirstOrDefaultAsync();
            string serie = config?.SerieFactura ?? "FAC";
            string subserie = config?.SubserieFactura ?? "";
            bool incluirAnio = config?.IncluirAñoEnSerie ?? true;
            bool incluirMes = config?.IncluirMesEnSerie ?? false;
            int longitudNumero = config?.LongitudNumeroFactura ?? 2;
            
            int anioActual = DateTime.Now.Year;
            int mesActual = DateTime.Now.Month;
            int siguienteNumero = config?.NumeroFacturaActual ?? 1;
            
            // Generar número de factura
            string numeroFactura;
            if (incluirAnio)
            {
                var mes = incluirMes ? mesActual.ToString("D2") : "";
                var separador = incluirMes ? "-" : "";
                numeroFactura = $"{serie}{anioActual}{subserie}{mes}{separador}{siguienteNumero.ToString().PadLeft(longitudNumero, '0')}";
            }
            else
            {
                numeroFactura = $"{serie}-{siguienteNumero.ToString().PadLeft(longitudNumero, '0')}";
            }
            
            decimal ivaPorDefecto = config?.IVAPorDefecto ?? 21m;
            
            // Calcular importe base (usar TotalImporte o Importe si está disponible, sino 0)
            decimal importeBase = viaje.TotalImporte ?? viaje.Importe ?? 0m;
            
            // Crear la factura
            var nuevaFactura = new Factura
            {
                NumeroFactura = numeroFactura,
                FechaEmision = DateTime.Now,
                FechaOperacion = viaje.FechaSalida ?? DateTime.Now,
                ClienteId = viaje.ClienteId.Value,
                BaseImponible = importeBase,
                PorcentajeIVA = ivaPorDefecto,
                ImporteIVA = importeBase * (ivaPorDefecto / 100),
                Total = importeBase * (1 + ivaPorDefecto / 100),
                Estado = EstadoFactura.Borrador,
                Concepto = $"Viaje Discrecional - {viaje.Descripcion ?? viaje.Codigo}",
                EmpresaId = CurrentEmpresaId ?? 1
            };
            
            context.Facturas.Add(nuevaFactura);
            await context.SaveChangesAsync();
            
            // Crear línea de factura
            var descripcionLinea = viaje.Descripcion ?? viaje.Codigo ?? "Viaje Discrecional";
            if (viaje.FechaSalida.HasValue)
            {
                descripcionLinea += $" - {viaje.FechaSalida.Value:dd/MM/yyyy}";
            }
            
            var lineaFactura = new LineaFactura
            {
                FacturaId = nuevaFactura.Id,
                Descripcion = descripcionLinea,
                Cantidad = 1,
                PrecioUnitario = importeBase,
                Subtotal = importeBase,
                Tipo = TipoLineaFactura.Servicio,
                ViajeIdDiscrecional = viajeId
            };
            
            context.LineasFactura.Add(lineaFactura);
            
            // Actualizar el número de factura en la configuración
            if (config != null)
            {
                config.NumeroFacturaActual = siguienteNumero + 1;
            }
            
            await context.SaveChangesAsync();
            
            // Cerrar modal y redirigir a facturas
            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('viajeDiscrecionalModal')).hide()");
            await JSRuntime.InvokeVoidAsync("alert", $"Factura {numeroFactura} generada correctamente");
            
            NavigationManager.NavigateTo("/facturas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar factura: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al generar la factura: {ex.Message}");
        }
    }
}

