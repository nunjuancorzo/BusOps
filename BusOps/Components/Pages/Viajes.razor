@code {
    [Parameter]
    public string? Tipo { get; set; }
    
    private List<ViajeFijo> viajesFijos = new();
    private List<ViajeDiscrecional> viajesDiscrecionales = new();
    private List<Ruta> rutas = new();
    private List<Autobus> autobuses = new();
    private List<Conductor> conductores = new();
    private List<Cliente> clientes = new();
    private ViajeFijo viajeSeleccionado = new();
    private ViajeDiscrecional viajeDiscrecionalSeleccionado = new();
    private Ruta nuevaRuta = new();
    private double duracionHoras = 8;
    private DateTime fechaHoraSalida = DateTime.Now.AddDays(1).Date.AddHours(8);
    private DateTime fechaHoraLlegadaEstimada = DateTime.Now.AddDays(1).Date.AddHours(16);
    
    // Variables para viajes fijos (horarios detallados)
    private TimeOnly? horaPresentacionFijo;
    private TimeOnly? horaSalidaFijo;
    private TimeOnly? horaLlegadaFijo;
    
    // Variables para viajes discrecionales
    private TimeOnly? horaPresentacionDisc;
    private TimeOnly? horaSalidaDisc;
    private TimeOnly? horaLlegadaDisc;
    private TimeOnly? horaPresentacionCierreDisc;
    private TimeOnly? horaSalidaCierreDisc;
    private TimeOnly? horaLlegadaCierreDisc;
    
    private EstadoViaje? filtroEstado = null;
    private bool hasLoaded = false;
    private int? CurrentEmpresaId;
    private bool IsSuperAdmin;

    private IEnumerable<ViajeFijo> ViajesFijosFiltrados =>
        filtroEstado == null ? viajesFijos : viajesFijos.Where(v => v.Estado == filtroEstado);
    
    private IEnumerable<ViajeDiscrecional> ViajesDiscrecionalesFiltrados =>
        filtroEstado == null ? viajesDiscrecionales : viajesDiscrecionales.Where(v => v.Estado == filtroEstado);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hasLoaded)
        {
            var empresaIdResult = await SessionStorage.GetAsync<int?>("EmpresaId");
            CurrentEmpresaId = empresaIdResult.Success ? empresaIdResult.Value : null;
            
            var roleResult = await SessionStorage.GetAsync<string>("userRole");
            IsSuperAdmin = roleResult.Success && roleResult.Value == Roles.SuperAdministrador;
            
            Console.WriteLine($"🚌 VIAJES - EmpresaId: {CurrentEmpresaId}, IsSuperAdmin: {IsSuperAdmin}");
            
            await CargarViajes();
            await CargarRutas();
            await CargarAutobuses();
            await CargarConductores();
            await CargarClientes();
            
            // Verificar si hay una ruta seleccionada para crear un nuevo viaje
            var rutaIdResult = await SessionStorage.GetAsync<int>("RutaIdParaNuevoViaje");
            if (rutaIdResult.Success && rutaIdResult.Value > 0)
            {
                // Eliminar INMEDIATAMENTE del SessionStorage para evitar bucles
                var rutaId = rutaIdResult.Value;
                await SessionStorage.DeleteAsync("RutaIdParaNuevoViaje");
                
                // Crear el viaje y abrir el modal
                await CrearViajeDesdeRuta(rutaId);
            }
            
            hasLoaded = true;
            StateHasChanged();
        }
    }

    private async Task CargarViajes()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        
        viajesFijos = await context.ViajesFijos
            .Include(v => v.Ruta)
            .Include(v => v.Autobus)
            .Include(v => v.Conductor)
            .ToListAsync();
        
        viajesDiscrecionales = await context.ViajesDiscrecionales
            .Include(v => v.Cliente)
            .Include(v => v.Autobus)
            .Include(v => v.Conductor1)
            .Include(v => v.Conductor2Nav)
            .ToListAsync();
    }

    private async Task CargarRutas()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        
        rutas = await context.Rutas.Where(r => r.Activa).ToListAsync();
    }

    private async Task CargarAutobuses()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        
        autobuses = await context.Autobuses.ToListAsync();
    }

    private async Task CargarConductores()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        
        conductores = await context.Conductores.ToListAsync();
    }
    
    private async Task CargarClientes()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        context.IsSuperAdmin = IsSuperAdmin;
        context.CurrentEmpresaId = CurrentEmpresaId;
        clientes = await context.Clientes.ToListAsync();
    }

    private void MostrarFormularioNuevo()
    {
        viajeSeleccionado = new ViajeFijo
        {
            Estado = EstadoViaje.Programado,
            AsientosDisponibles = 50
        };
        fechaHoraSalida = DateTime.Now.AddDays(1).Date.AddHours(8);
        fechaHoraLlegadaEstimada = DateTime.Now.AddDays(1).Date.AddHours(16);
        horaPresentacionFijo = null;
        horaSalidaFijo = null;
        horaLlegadaFijo = null;
    }

    private async Task CrearViajeDesdeRuta(int rutaId)
    {
        // Buscar la ruta en la lista cargada
        var ruta = rutas.FirstOrDefault(r => r.Id == rutaId);
        
        if (ruta == null)
        {
            // Si no está en la lista, cargarla desde la base de datos
            using var context = await DbFactory.CreateDbContextAsync();
            context.IsSuperAdmin = IsSuperAdmin;
            context.CurrentEmpresaId = CurrentEmpresaId;
            ruta = await context.Rutas.FindAsync(rutaId);
        }
        
        if (ruta != null)
        {
            // Crear un nuevo viaje fijo preconfigurado con los datos de la ruta
            viajeSeleccionado = new ViajeFijo
            {
                RutaId = ruta.Id,
                Estado = EstadoViaje.Programado,
                
                // Asignar datos básicos de la ruta
                ClienteId = ruta.ClienteId,
                CodigoCliente = ruta.CodigoCliente?.ToString() ?? string.Empty,
                
                // Lugares
                LugarSalida = ruta.Origen,
                LugarLlegada = ruta.Destino,
                
                // Plazas y precio
                Plazas = ruta.Plazas,
                AsientosDisponibles = ruta.Plazas ?? 50,
                PrecioViaje = ruta.PrecioBase,
                
                // Horarios de la ruta
                HoraPresentacion = ruta.HoraPresentacion,
                HoraSalida = ruta.HoraSalida,
                HoraLlegada = ruta.HoraLlegada,
                
                // Kilometraje
                KmsTotales = ruta.Kilometros,
                
                // Asignaciones
                AutobusId = ruta.AutobusId ?? 0,
                ConductorId = ruta.ConductorId ?? 0,
                Matricula = ruta.VehiculoMatricula,
                
                // Tipo de servicio
                CodigoTipoServicio = ruta.CodigoTipoServicio,
                ServicioTipo = ruta.TipoServicio,
                
                // Descripción
                Descripcion = ruta.Descripcion
            };
            
            // Configurar fechas para mañana (o el siguiente día operativo según la ruta)
            var fechaBase = DateTime.Now.AddDays(1).Date;
            
            // Calcular la hora de salida
            if (ruta.HoraSalida.HasValue)
            {
                fechaHoraSalida = fechaBase.Add(ruta.HoraSalida.Value);
            }
            else
            {
                fechaHoraSalida = fechaBase.AddHours(8);
            }
            
            // Calcular la hora de llegada estimada
            if (ruta.HoraLlegada.HasValue)
            {
                fechaHoraLlegadaEstimada = fechaBase.Add(ruta.HoraLlegada.Value);
            }
            else if (ruta.DuracionEstimada != TimeSpan.Zero)
            {
                fechaHoraLlegadaEstimada = fechaHoraSalida.Add(ruta.DuracionEstimada);
            }
            else
            {
                fechaHoraLlegadaEstimada = fechaHoraSalida.AddHours(8);
            }
            
            // Convertir TimeSpan a TimeOnly para los horarios
            horaPresentacionFijo = ruta.HoraPresentacion.HasValue ? TimeOnly.FromTimeSpan(ruta.HoraPresentacion.Value) : null;
            horaSalidaFijo = ruta.HoraSalida.HasValue ? TimeOnly.FromTimeSpan(ruta.HoraSalida.Value) : null;
            horaLlegadaFijo = ruta.HoraLlegada.HasValue ? TimeOnly.FromTimeSpan(ruta.HoraLlegada.Value) : null;
            
            // Abrir el modal automáticamente
            await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('viajeModal')).show()");
        }
    }

    private void EditarViaje(ViajeFijo viaje)
    {
        viajeSeleccionado = new ViajeFijo
        {
            Id = viaje.Id,
            Codigo = viaje.Codigo,
            Referencia = viaje.Referencia,
            Expediente = viaje.Expediente,
            DescripcionExpediente = viaje.DescripcionExpediente,
            RutaId = viaje.RutaId,
            AutobusId = viaje.AutobusId,
            ConductorId = viaje.ConductorId,
            Conductor2Id = viaje.Conductor2Id,
            ClienteId = viaje.ClienteId,
            FechaHoraSalida = viaje.FechaHoraSalida,
            FechaHoraLlegadaEstimada = viaje.FechaHoraLlegadaEstimada,
            FechaHoraLlegadaReal = viaje.FechaHoraLlegadaReal,
            AsientosDisponibles = viaje.AsientosDisponibles,
            Plazas = viaje.Plazas,
            PrecioViaje = viaje.PrecioViaje,
            TotalImporte = viaje.TotalImporte,
            Importe = viaje.Importe,
            TotalProveedor = viaje.TotalProveedor,
            NumeroFactura = viaje.NumeroFactura,
            Descripcion = viaje.Descripcion,
            Ampliacion = viaje.Ampliacion,
            LugarSalida = viaje.LugarSalida,
            LugarLlegada = viaje.LugarLlegada,
            Itinerario = viaje.Itinerario,
            KmsInicio = viaje.KmsInicio,
            KmsFin = viaje.KmsFin,
            KmsTotales = viaje.KmsTotales,
            Responsable = viaje.Responsable,
            NombreGrupo = viaje.NombreGrupo,
            ServicioTipo = viaje.ServicioTipo,
            NotasInternas = viaje.NotasInternas,
            Notas = viaje.Notas,
            Comisionista = viaje.Comisionista,
            ImporteComisionista = viaje.ImporteComisionista,
            Anulado = viaje.Anulado,
            Estado = viaje.Estado
        };
        fechaHoraSalida = viaje.FechaHoraSalida;
        fechaHoraLlegadaEstimada = viaje.FechaHoraLlegadaEstimada;
        
        horaPresentacionFijo = viaje.HoraPresentacion.HasValue ? TimeOnly.FromTimeSpan(viaje.HoraPresentacion.Value) : null;
        horaSalidaFijo = viaje.HoraSalida.HasValue ? TimeOnly.FromTimeSpan(viaje.HoraSalida.Value) : null;
        horaLlegadaFijo = viaje.HoraLlegada.HasValue ? TimeOnly.FromTimeSpan(viaje.HoraLlegada.Value) : null;
    }

    private void OnRutaSeleccionada()
    {
        if (viajeSeleccionado.RutaId > 0)
        {
            // Buscar la ruta seleccionada y asignar su precio base
            var rutaSeleccionada = rutas.FirstOrDefault(r => r.Id == viajeSeleccionado.RutaId);
            
            if (rutaSeleccionada != null)
            {
                viajeSeleccionado.PrecioViaje = rutaSeleccionada.PrecioBase;
            }
        }
    }

    private void OnAutobusSeleccionado()
    {
        if (viajeSeleccionado.AutobusId > 0)
        {
            // Buscar si el autobús tiene un conductor asignado
            var conductorAsignado = conductores.FirstOrDefault(c => c.AutobusId == viajeSeleccionado.AutobusId && c.Estado == EstadoConductor.Activo);
            
            if (conductorAsignado != null)
            {
                viajeSeleccionado.ConductorId = conductorAsignado.Id;
            }
        }
    }

