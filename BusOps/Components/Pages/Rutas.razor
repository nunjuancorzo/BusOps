        rutaSeleccionada2.DuracionEstimada = TimeSpan.FromHours(duracionHoras);
        rutaSeleccionada2.FechaInicio = fechaInicio;
        rutaSeleccionada2.FechaFin = fechaFin;
        rutaSeleccionada2.HoraPresentacion = horaPresentacion.HasValue ? horaPresentacion.Value.ToTimeSpan() : null;
