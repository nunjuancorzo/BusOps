                rutaExistente.FechaFin = rutaSeleccionada2.FechaFin;
                rutaExistente.HoraPresentacion = rutaSeleccionada2.HoraPresentacion;
                rutaExistente.HoraSalida = rutaSeleccionada2.HoraSalida;
                rutaExistente.HoraLlegada = rutaSeleccionada2.HoraLlegada;
                rutaExistente.DuracionEstimada = rutaSeleccionada2.DuracionEstimada;
                rutaExistente.Plazas = rutaSeleccionada2.Plazas;
                rutaExistente.DistanciaKm = rutaSeleccionada2.DistanciaKm;
                rutaExistente.Kilometros = rutaSeleccionada2.Kilometros;
                rutaExistente.Lunes = rutaSeleccionada2.Lunes;
                rutaExistente.Martes = rutaSeleccionada2.Martes;
                rutaExistente.Miercoles = rutaSeleccionada2.Miercoles;
                rutaExistente.Jueves = rutaSeleccionada2.Jueves;
                rutaExistente.Viernes = rutaSeleccionada2.Viernes;
                rutaExistente.Sabado = rutaSeleccionada2.Sabado;
                rutaExistente.Domingo = rutaSeleccionada2.Domingo;
                rutaExistente.CodigoLineaRegular = rutaSeleccionada2.CodigoLineaRegular;
                rutaExistente.LineaRegular = rutaSeleccionada2.LineaRegular;
                rutaExistente.CodigoAgregacion = rutaSeleccionada2.CodigoAgregacion;
                rutaExistente.Agregacion = rutaSeleccionada2.Agregacion;
                rutaExistente.CodigoTipoServicio = rutaSeleccionada2.CodigoTipoServicio;
                rutaExistente.TipoServicio = rutaSeleccionada2.TipoServicio;
                rutaExistente.Asistente = rutaSeleccionada2.Asistente;
                rutaExistente.CodigoCliente = rutaSeleccionada2.CodigoCliente;
                rutaExistente.ClienteId = rutaSeleccionada2.ClienteId;
